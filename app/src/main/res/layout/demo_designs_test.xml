<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardDashboardSummary"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="6dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/bg_dashboard_card"
    app:strokeWidth="1dp"
    app:strokeColor="@color/border_dashboard_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- Circular progress -->
        <FrameLayout
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:layout_gravity="center">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/occupancyProgressBar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:progress="30"
                android:max="100"
                android:layout_gravity="center"
                app:indicatorColor="@color/progress_active"
                app:indicatorSize="100dp"
                app:trackColor="@color/progress_inactive"
                app:trackThickness="8dp"
                app:trackCornerRadius="5dp" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_gravity="center">
                <TextView
                    android:id="@+id/tvProgressLabel"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/text_any_number"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#111827"
                    android:gravity="center"/>

                <TextView
                    android:id="@+id/tvProgressLabel3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/text_occupied"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_muted"
                    android:gravity="center"/>


            </LinearLayout>

        </FrameLayout>

        <!-- RIGHT : Content -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                    <!-- Rent Collected -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_cash_payment"
                        app:tint="@color/entity_rent_icon" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:letterSpacing="0.05"
                        android:text="TOTAL RENT COLLECTED"
                        android:textColor="#9BA5B7"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹61,621"
                    android:textColor="#1A202C"
                    android:textSize="24sp"
                    android:textStyle="bold" />

            </LinearLayout>



            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="8dp"
                android:background="@color/light_separator" />

            <!-- Bottom Stats -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:weightSum="2">

                <!-- Utilities -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:ignore="UseCompoundDrawables">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@string/text_image_desc"
                            android:src="@drawable/ic_single_bed"
                            app:tint="@color/icon_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:text="@string/text_label_elc_bill_cap"
                            android:textAllCaps="true"
                            android:layout_gravity="center_vertical"
                            android:textColor="@color/text_subheading"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvMonthTotalElcBill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/text_value_amount"
                        android:layout_marginStart="2dp"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_heading" />
                </LinearLayout>

                <!-- Active Units -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:ignore="UseCompoundDrawables">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@string/text_image_desc"
                            android:src="@drawable/ic_single_bed"
                            app:tint="@color/icon_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:text="@string/text_label_consumed_cap"
                            android:textAllCaps="true"
                            android:layout_gravity="center_vertical"
                            android:textColor="@color/text_subheading"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:ignore="UseCompoundDrawables"
                        android:layout_marginStart="2dp">

                        <TextView
                            android:id="@+id/tvMonthTotalUnitsUsed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/text_any_number"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_heading" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/text_units"
                            android:layout_marginStart="4dp"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_muted" />

                    </LinearLayout>


                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>