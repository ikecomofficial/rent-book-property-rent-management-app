<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/bottomSheetRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="16dp"
    android:paddingBottom="12dp"
    android:background="@drawable/bg_bottom_sheet">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginHorizontal="8dp">

        <!-- Drag Handle -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="48dp"
            android:layout_height="5dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="3dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/light_separator" />

        <!-- Title -->
        <TextView
            android:id="@+id/tvTenantHistoryTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/text_tenant_history"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/text_heading" />

        <!-- Subtitle Row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Room -->
            <TextView
                android:id="@+id/tvBSRoomName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/text_room_01"
                android:textSize="16sp"
                android:textColor="@color/text_subheading" />

            <!-- Dot -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:text="•"
                android:textSize="18sp"
                android:textColor="@color/text_subheading" />

            <!-- Property -->
            <TextView
                android:id="@+id/tvBSPropertyName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/text_value_prop_name"
                android:textSize="16sp"
                android:textColor="@color/text_subheading" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="6dp"
            android:background="@color/light_separator" />

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- RecyclerView for tenants -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvAllPastTenants"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="vertical"/>

        <LinearLayout
            android:id="@+id/layoutNoTenantHistory"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone"
            android:gravity="center_horizontal"
            android:paddingVertical="25dp">

            <!-- Icon -->
            <ImageView
                android:id="@+id/img_empty_property"
                android:layout_width="180dp"
                android:layout_height="120dp"
                android:scaleType="centerCrop"
                android:src="@drawable/img_no_tenant_history"
                android:layout_marginBottom="24dp"
                android:contentDescription="@string/text_image_desc"/>

            <!-- Title -->
            <TextView
                android:id="@+id/tv_empty_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/text_heading_no_tenant_history"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text_heading"
                android:gravity="center" />

            <!-- Subtitle -->
            <TextView
                android:id="@+id/tv_empty_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/text_sub_no_tenant_history"
                android:textSize="14sp"
                android:textColor="@color/text_subheading"
                android:gravity="center"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="4dp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnBSAddTenant"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginTop="20dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/btn_primary"
                app:cardCornerRadius="22dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    tools:ignore="UseCompoundDrawables">

                    <!-- Plus Icon -->
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@string/text_image_desc"
                        android:src="@drawable/ic_add_user"
                        app:tint="@color/btn_primary_text" />

                    <!-- Text -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/text_btn_add_first_tenant"
                        android:textColor="@color/btn_primary_text"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


        </LinearLayout>


    </FrameLayout>

</LinearLayout>
