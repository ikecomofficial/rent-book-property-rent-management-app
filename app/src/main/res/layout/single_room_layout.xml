<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mcvRoomsMain"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="24dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="@color/bg_list_layout_primary"
    app:strokeColor="@color/border_list_layout_primary"
    app:strokeWidth="1dp"
    android:layout_marginHorizontal="2dp"
    android:layout_marginVertical="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="13dp"
        android:paddingBottom="16dp">

        <!-- TOP ROW -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="3dp">

            <!-- Room name + status -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/tvRoomName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/text_room_01"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_heading"/>

                <!-- PAID pill -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardRoomOccupancy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp"
                    android:layout_marginTop="2dp"
                    app:cardBackgroundColor="@color/occ_status_bg">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:paddingHorizontal="10dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="4dp">

                        <!-- Inner Dot -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/dotRoomOccupancy"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:layout_gravity="center"
                            app:cardBackgroundColor="@color/status_occupied"
                            app:cardCornerRadius="7dp"
                            app:strokeWidth="0dp"
                            app:cardElevation="0dp"
                            android:layout_marginTop="1dp"/>

                        <TextView
                            android:id="@+id/tvRoomStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="@string/text_occupied"
                            android:textSize="13sp"
                            android:textColor="#16A34A"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="1dp"
                android:layout_height="36dp"
                android:background="#E5E7EB"
                android:layout_marginEnd="14dp"/>

            <!-- Monthly Rent Section -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/text_monthly_rent"
                    android:textSize="13sp"
                    android:textColor="@color/text_subheading_fade"/>

                <TextView
                    android:id="@+id/tvRoomRent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/text_value_amount"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_purple_300"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="1dp"
                android:layout_height="36dp"
                android:background="#E5E7EB"
                android:layout_marginHorizontal="14dp"/>

            <!-- Rent Status Section -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/text_rent_status"
                    android:textSize="13sp"
                    android:textColor="@color/text_subheading_fade"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp"
                    tools:ignore="UseCompoundDrawables">

                    <ImageView
                        android:id="@+id/imgRentStatus"
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:contentDescription="@string/text_image_desc"
                        android:src="@drawable/ic_verified"
                        app:tint="@color/occ_status_dot"
                        android:layout_marginEnd="5dp"/>

                    <TextView
                        android:id="@+id/tvRoomRentStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/text_paid"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/occ_status_dot"/>
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- TENANT CARD -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/bg_info_container"
            app:strokeColor="@color/border_info_container"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="14dp"
                android:gravity="center_vertical">

                <!-- Avatar -->
                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/imgTenantProfile"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:src="@drawable/ic_tenant_profile_default"
                    android:scaleType="centerCrop"/>

                <!-- Name + phone -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvTenantName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/text_value_name"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_heading"/>

                    <TextView
                        android:id="@+id/tvTenantNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/text_value_mobile_no"
                        android:textSize="14sp"
                        android:textColor="@color/text_muted"/>
                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="1dp"
                    android:layout_height="36dp"
                    android:background="#E5E7EB"/>

                <!-- Meter -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/text_meter_cap"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_muted"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginTop="4dp"
                        tools:ignore="UseCompoundDrawables">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginEnd="5dp"
                            android:src="@drawable/ic_electric_bolt"
                            android:layout_gravity="center_vertical"
                            app:tint="@color/icon_lightning_bolt"
                            android:contentDescription="@string/text_image_desc"/>

                        <TextView
                            android:id="@+id/tvLastPaidUnit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/text_any_number"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/primary_main"/>

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>