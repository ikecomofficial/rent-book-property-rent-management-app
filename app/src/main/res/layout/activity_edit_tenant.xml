<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app_surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginVertical="18dp">

            <!-- TITLE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/text_label_tenant_details_cap"
                android:textAllCaps="true"
                android:textColor="@color/text_muted"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginHorizontal="14dp"
                android:background="@color/text_subheading_fade"/>

        </LinearLayout>

        <!-- CARD -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="24dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="@color/bg_list_layout_primary"
            app:strokeColor="@color/border_dashboard_card"
            app:strokeWidth="0.5dp"
            android:layout_marginHorizontal="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- PROPERTY NAME LABEL -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/text_label_tenant_name"
                    android:textColor="@color/text_subheading"
                    android:textSize="13sp"
                    android:textAllCaps="true"
                    android:textStyle="bold"
                    android:letterSpacing="0.04"
                    android:paddingBottom="8dp"/>

                <!-- PROPERTY NAME INPUT -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_et_input"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@string/text_image_desc"
                        android:src="@drawable/ic_person"
                        app:tint="@color/icon_primary"/>

                    <EditText
                        android:id="@+id/etEditTenantName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/text_hint_tenant_name"
                        android:textColorHint="@color/text_subheading_fade"
                        android:textColor="@color/text_heading"
                        android:background="@android:color/transparent"
                        android:paddingStart="12dp"
                        android:paddingVertical="8dp"
                        android:paddingEnd="2dp"
                        android:inputType="textCapWords"
                        android:textSize="16sp"/>
                </LinearLayout>

                <!-- SPACE -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="20dp"/>

                <!-- PROPERTY NAME LABEL -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/text_label_mobile_no"
                    android:textColor="@color/text_subheading"
                    android:textSize="13sp"
                    android:textAllCaps="true"
                    android:textStyle="bold"
                    android:letterSpacing="0.04"
                    android:paddingBottom="8dp"/>

                <!-- PROPERTY NAME INPUT -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_et_input"
                    android:paddingHorizontal="16dp">

                    <!-- Country Code -->
                    <TextView
                        android:id="@+id/textCountryCode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/text_country_code_in"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/icon_primary"
                        android:gravity="center_vertical"
                        android:background="@android:color/transparent" />

                    <EditText
                        android:id="@+id/etEditTenantPhone"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:hint="@string/text_hint_10_digit_no"
                        android:textColorHint="@color/text_subheading_fade"
                        android:textColor="@color/text_heading"
                        android:background="@android:color/transparent"
                        android:layout_weight="1"
                        android:paddingStart="12dp"
                        android:paddingVertical="8dp"
                        android:paddingEnd="2dp"
                        android:maxLength="10"
                        android:inputType="phone"
                        android:textSize="16sp"/>

                    <ImageView
                        android:id="@+id/btnPickContact"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:contentDescription="@string/text_image_desc"
                        app:tint="@color/icon_primary"
                        android:src="@drawable/ic_contact_pick"/>

                </LinearLayout>

                <!-- SPACE -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="20dp"/>

                <!-- ADDRESS LABEL -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/text_label_address"
                    android:textColor="@color/text_subheading"
                    android:textSize="13sp"
                    android:textAllCaps="true"
                    android:textStyle="bold"
                    android:letterSpacing="0.04"
                    android:paddingBottom="8dp"/>

                <!-- ADDRESS INPUT -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_et_input"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@string/text_image_desc"
                        android:src="@drawable/ic_home_location"
                        app:tint="@color/icon_primary"/>

                    <EditText
                        android:id="@+id/etEditTenantAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/text_hint_address"
                        android:textColorHint="@color/text_subheading_fade"
                        android:textColor="@color/text_heading"
                        android:background="@android:color/transparent"
                        android:paddingStart="12dp"
                        android:paddingVertical="8dp"
                        android:paddingEnd="2dp"
                        android:inputType="textCapWords"
                        android:textSize="16sp"/>
                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <Space
            android:layout_width="match_parent"
            android:layout_height="32dp"/>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnUpdateTenant"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:clickable="true"
            android:focusable="true"
            app:cardCornerRadius="50dp"
            android:layout_margin="3dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/btn_primary">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center"
                tools:ignore="UseCompoundDrawables">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/text_image_desc"
                    android:src="@drawable/ic_add_user"
                    app:tint="@color/white"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/text_btn_update_tenant"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"/>
            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <Space
            android:layout_width="match_parent"
            android:layout_height="16dp"/>

    </LinearLayout>

</ScrollView>