<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/layoutHeaderTenantName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_gravity="center"
        android:layout_marginTop="6dp"
        android:layout_marginHorizontal="3dp"
        android:visibility="gone">

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:layout_gravity="center_vertical"
            android:background="@color/light_separator"/>

        <TextView
            android:id="@+id/tvHeaderTenantName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/text_value_name"
            android:textStyle="bold"
            android:textColor="@color/text_subheading"
            android:layout_marginHorizontal="16dp"/>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:layout_gravity="center_vertical"
            android:background="@color/light_separator"/>

    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="20dp"
        app:cardElevation="1dp"
        android:layout_marginVertical="6dp"
        android:layout_marginHorizontal="2dp"
        app:strokeWidth="1dp"
        app:strokeColor="#E6EAF0"
        android:backgroundTint="@android:color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16sp"
            android:paddingTop="16sp"
            android:paddingBottom="12dp">

            <!-- Top Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Icon -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    android:backgroundTint="#E9F8F4">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/text_image_desc"
                        android:padding="10dp"
                        android:src="@drawable/ic_receipt_long"
                        app:tint="@color/icon_primary" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Month & Units -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:id="@+id/tvRentMonthYear"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/text_value_month_year"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#1F2937" />


                    <!-- Date #6B7280, #9AA3AF icons -->
                    <TextView
                        android:id="@+id/tvRentPeriod"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/text_value_rent_interval"
                        android:textSize="13sp"
                        android:textColor="#6B7280"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>

                <!-- Amount & Mode -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="end">

                    <TextView
                        android:id="@+id/tvRentAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/text_value_amount"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#009688" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="4dp"
                        tools:ignore="UseCompoundDrawables">

                        <ImageView
                            android:id="@+id/imgRentPaymentMode"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:contentDescription="@string/text_image_desc"
                            android:src="@drawable/ic_cash_payment"
                            app:tint="#9AA3AF" />

                        <TextView
                            android:id="@+id/tvRentPaymentMode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/text_cash"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#9AA3AF"
                            android:layout_marginStart="6dp" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="10dp"
                android:background="@color/light_separator" />

            <!-- Bottom Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginStart="2dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@string/text_image_desc"
                    android:src="@drawable/ic_clock"
                    app:tint="#6B7280"
                    android:layout_gravity="center_vertical"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Paid On"
                    android:textSize="14sp"
                    android:textColor="#6B7280"
                    android:layout_marginStart="8dp" />

                <TextView
                    android:id="@+id/tvRentDateTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/text_value_date_time"
                    android:textSize="13sp"
                    android:textStyle="italic"
                    android:textColor="#6B7280"
                    android:layout_marginStart="3dp" />


            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>



</LinearLayout>
