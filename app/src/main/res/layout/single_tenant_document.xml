<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="100dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="7dp"
    android:gravity="center_horizontal">

    <!-- CardView for rounded image -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="100dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="3dp"
        app:cardUseCompatPadding="false">

        <ImageView
            android:id="@+id/imgTenantDocument"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/text_image_desc"
            android:scaleType="centerCrop"
            android:src="@drawable/img_placeholder_document" />
    </androidx.cardview.widget.CardView>

    <!-- File name text -->
    <TextView
        android:id="@+id/tvTenantDocName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginVertical="8dp"
        android:text="@string/text_value_doc_name"
        android:textSize="15sp"
        android:paddingHorizontal="3dp"
        android:textStyle="bold"
        android:textColor="@color/text_heading"
        android:ellipsize="end"
        android:maxLines="1" />

</LinearLayout>
