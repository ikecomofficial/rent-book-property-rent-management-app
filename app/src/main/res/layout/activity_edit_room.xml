<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app_surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginVertical="18dp">

            <!-- TITLE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/text_label_financial_cap"
                android:textAllCaps="true"
                android:textColor="@color/text_muted"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginHorizontal="14dp"
                android:background="@color/text_subheading_fade"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <!-- CARD 1: TOTAL ROOMS -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:cardCornerRadius="24dp"
                app:strokeWidth="0.5dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border_dashboard_card"
                app:cardBackgroundColor="@color/bg_list_layout_primary">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp">

                    <!-- Title -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/text_label_base_rent"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_subheading"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="12dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_et_input"
                        android:paddingHorizontal="16dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:contentDescription="@string/text_image_desc"
                            android:src="@drawable/ic_cash_payment"
                            app:tint="@color/icon_primary"/>

                        <EditText
                            android:id="@+id/etUpdateRoomRent"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@android:color/transparent"
                            android:hint="@string/text_value_amount"
                            android:textSize="16sp"
                            android:paddingVertical="6dp"
                            android:textColor="@color/text_heading"
                            android:textColorHint="@color/text_subheading_fade"
                            android:inputType="number"
                            android:paddingHorizontal="12dp"/>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <View
                android:layout_width="12dp"
                android:layout_height="match_parent"/>


            <!-- CARD 2: TOTAL SHOPS -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:cardCornerRadius="20dp"
                app:strokeWidth="0.5dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border_dashboard_card"
                app:cardBackgroundColor="@color/bg_list_layout_primary">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp">

                    <!-- Title -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/text_label_elc_unit_rate"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_subheading"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="12dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_et_input"
                        android:paddingHorizontal="16dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@string/text_image_desc"
                            android:src="@drawable/ic_electric_bolt"
                            app:tint="@color/bg_orange"/>

                        <EditText
                            android:id="@+id/etUpdateUnitRate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@android:color/transparent"
                            android:hint="@string/text_value_amount"
                            android:textSize="16sp"
                            android:paddingVertical="6dp"
                            android:textColor="@color/text_heading"
                            android:textColorHint="@color/text_subheading_fade"
                            android:inputType="numberDecimal"
                            android:paddingHorizontal="12dp"/>

                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="32dp"/>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnUpdateRoom"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:clickable="true"
            android:focusable="true"
            app:cardCornerRadius="50dp"
            android:layout_margin="3dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/btn_primary">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center"
                tools:ignore="UseCompoundDrawables">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/text_image_desc"
                    android:src="@drawable/ic_single_bed"
                    app:tint="@color/white"/>

                <TextView
                    android:id="@+id/tvBtnUpdate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/text_btn_update_room"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"/>
            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <Space
            android:layout_width="match_parent"
            android:layout_height="16dp"/>

    </LinearLayout>

</ScrollView>