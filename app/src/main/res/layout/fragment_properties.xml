<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app_surface"
    android:orientation="vertical">

    <!-- Header Container -->
    <LinearLayout
        android:id="@+id/headerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="18dp"
        tools:ignore="MissingConstraints">

        <!-- Left side: Welcome + Title -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/text_welcome"
                android:textColor="@color/text_muted"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvUserName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/text_user"
                android:textColor="@color/text_heading"
                android:textSize="28sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Notification Icon -->
        <ImageView
            android:id="@+id/iv_notification"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="16dp"
            android:contentDescription="@string/text_image_desc"
            android:src="@drawable/ic_bell"
            app:tint="@color/icon_primary" />

        <!-- Circle Image View (Profile Pic) -->
        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/cimgUserAccount"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_user_profile"
            app:civ_border_color="@android:color/transparent"
            app:civ_border_width="0dp" />

    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="20dp"
        app:cardElevation="2dp"
        android:layout_marginHorizontal="14dp"
        android:layout_marginBottom="12dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/border_dashboard_card"
        app:cardBackgroundColor="@color/bg_dashboard_card">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center_vertical">

            <!-- Circular progress -->
            <FrameLayout
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:layout_gravity="center">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/occupancyProgressBar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:progress="30"
                    android:max="100"
                    android:layout_gravity="center"
                    app:indicatorColor="@color/progress_active"
                    app:indicatorSize="80dp"
                    app:trackColor="@color/progress_inactive"
                    app:trackThickness="5dp"
                    app:trackCornerRadius="5dp" />
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_gravity="center">
                    <TextView
                        android:id="@+id/tvProgressLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/text_any_number"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_heading"
                        android:layout_gravity="center_horizontal"/>

                    <TextView
                        android:id="@+id/tvProgressLabel3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/text_occupied"
                        android:textSize="12sp"
                        android:textColor="@color/text_muted"
                        android:layout_gravity="center_horizontal"/>


                </LinearLayout>

            </FrameLayout>

            <!-- Space -->
            <View
                android:layout_width="16dp"
                android:layout_height="1dp"/>

            <!-- 🧊 Right Compact Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/border_dashboard_card"
                app:cardBackgroundColor="@color/bg_list_layout_primary">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:gravity="center_vertical">

                    <!-- 🏢 Rooms -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            app:cardBackgroundColor="@color/bg_dashboard_card"
                            app:cardCornerRadius="12dp"
                            app:strokeWidth="0dp"
                            app:cardElevation="0dp">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@string/text_image_desc"
                                android:padding="8dp"
                                android:src="@drawable/ic_single_bed"
                                app:tint="@color/icon_primary" />
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/text_rooms"
                                android:textSize="12sp"
                                android:textColor="@color/text_subheading_fade"/>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <TextView
                                    android:id="@+id/tvCombinedRoomOcc"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/text_any_number"
                                    android:textSize="16sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/primary_main"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/text_slash"
                                    android:textSize="16sp"
                                    android:textStyle="bold"
                                    android:layout_marginHorizontal="3dp"
                                    android:textColor="@color/text_heading"/>

                                <TextView
                                    android:id="@+id/tvCombinedRoomTotal"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/text_any_number"
                                    android:textSize="16sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/text_heading"/>

                            </LinearLayout>
                        </LinearLayout>

                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="0.7dp"
                        android:layout_height="32dp"
                        android:layout_marginEnd="8dp"
                        android:background="@color/light_separator"/>

                    <!-- 🏪 Shops -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            app:cardBackgroundColor="@color/bg_dashboard_card"
                            app:cardCornerRadius="12dp"
                            app:strokeWidth="0dp"
                            app:cardElevation="0dp">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@string/text_image_desc"
                                android:padding="9dp"
                                android:src="@drawable/ic_store_shop"
                                app:tint="@color/text_amount" />
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/text_shops"
                                android:textSize="12sp"
                                android:textColor="@color/text_subheading_fade"/>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <TextView
                                    android:id="@+id/tvCombinedShopOcc"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/text_any_number"
                                    android:textSize="16sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/text_amount"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    android:text="@string/text_slash"
                                    android:textColor="@color/text_heading"
                                    android:textSize="16sp"
                                    android:layout_marginHorizontal="3dp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvCombinedShopTotal"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/text_any_number"
                                    android:textSize="16sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/text_heading"/>

                            </LinearLayout>
                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/layout_properties_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16sp"
        android:paddingEnd="14dp">

        <!-- Title -->
        <TextView
            android:id="@+id/tvPropertiesCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/text_properties"
            android:textColor="@color/text_heading"
            android:textSize="20sp"
            android:textStyle="bold" />


        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnAddProperty"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_margin="6dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/btn_primary"
            app:cardBackgroundColor="@color/bg_dashboard_card"
            app:cardCornerRadius="22dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="1dp"
                android:paddingHorizontal="20dp"
                tools:ignore="UseCompoundDrawables">

                <!-- Plus Icon -->
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@string/text_image_desc"
                    android:src="@drawable/ic_input_plus"
                    app:tint="@color/btn_primary" />

                <!-- Text -->
                <TextView
                    android:id="@+id/tv_add_property"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/text_add_property"
                    android:textColor="@color/btn_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="14dp"
        android:paddingTop="6dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/propertyListRecycleView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

        <ProgressBar
            android:id="@+id/progressBarProperties"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="60dp"
            android:indeterminateTint="@color/primary_main"/>

        <LinearLayout
            android:id="@+id/layoutNoPropertyList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="50dp"
            android:visibility="gone">

            <!-- Icon -->
            <ImageView
                android:id="@+id/img_empty_property"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_marginBottom="24dp"
                android:contentDescription="@string/text_image_desc"
                android:src="@drawable/ic_property" />

            <!-- Title -->
            <TextView
                android:id="@+id/tv_empty_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/text_no_properties_added_yet"
                android:textColor="@color/text_heading"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Subtitle -->
            <TextView
                android:id="@+id/tv_empty_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:text="@string/text_start_managing_desc"
                android:textColor="@color/text_muted"
                android:textSize="14sp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnAddFirstProperty"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginTop="32dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/btn_primary"
                app:cardCornerRadius="22dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    tools:ignore="UseCompoundDrawables">

                    <!-- Plus Icon -->
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@string/text_image_desc"
                        android:src="@drawable/ic_input_plus"
                        app:tint="@color/btn_primary_text" />

                    <!-- Text -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/text_add_first_property"
                        android:textColor="@color/btn_primary_text"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>


    </FrameLayout>


</LinearLayout>