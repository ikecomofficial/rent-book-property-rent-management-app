<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:orientation="horizontal">

    <!-- LEFT TIMELINE AREA -->
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent">

        <!-- Single vertical line -->
        <View
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:background="#DADADA"/>

        <!-- Icon Card on top of line -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/mcvEntityIconBG"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="14dp"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@color/entity_rent_bg_border">

            <ImageView
                android:id="@+id/imgEntityIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/text_image_desc"
                android:padding="10dp"
                android:src="@drawable/ic_properties"
                app:tint="@color/entity_rent_icon"
                android:scaleType="centerInside"/>
        </com.google.android.material.card.MaterialCardView>

    </FrameLayout>


    <!-- RIGHT CONTENT AREA -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_margin="14dp">

        <!-- Title + Time -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvActivityLogTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/text_activity_log_title"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="@color/text_heading"/>

            <TextView
                android:id="@+id/tvActivityLogTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/text_value_time"
                android:textSize="14sp"
                android:textColor="@color/text_subheading"/>
        </LinearLayout>

        <!-- Date -->
        <TextView
            android:id="@+id/tvActivityLogDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/text_value_date"
            android:textSize="14sp"
            android:textColor="@color/text_subheading"
            android:layout_marginTop="4dp"/>

        <!-- Description Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/mcvEntityDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/entity_rent_bg_border"
            app:cardBackgroundColor="@color/entity_rent_bg">

            <TextView
                android:id="@+id/tvActivityLogDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="@string/text_activity_log_desc"
                android:textSize="15sp"
                android:textColor="@color/text_muted"
                android:lineSpacingExtra="2dp"/>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</LinearLayout>
