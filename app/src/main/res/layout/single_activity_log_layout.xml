<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:orientation="horizontal">

    <!-- LEFT TIMELINE AREA -->
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent">

        <!-- Single vertical line -->
        <View
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:background="@color/log_activity_timeline"/>

        <!-- Icon Card on top of line -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/mcvEntityIconBG"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="14dp"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@color/entity_rent_bg_border">

            <ImageView
                android:id="@+id/imgEntityIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/text_image_desc"
                android:padding="10dp"
                android:src="@drawable/ic_properties"
                app:tint="@color/entity_rent_icon"
                android:scaleType="centerInside"/>
        </com.google.android.material.card.MaterialCardView>

    </FrameLayout>


    <!-- RIGHT CONTENT AREA -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginHorizontal="14dp"
        android:layout_marginTop="14dp">

        <!-- Title + Time -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/tvActivityLogTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/text_activity_log_title"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@color/text_heading"/>

                <!-- Date -->
                <TextView
                    android:id="@+id/tvActivityLogDateTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/text_value_date"
                    android:textSize="14sp"
                    android:textColor="@color/text_subheading"
                    android:layout_marginTop="4dp"/>

            </LinearLayout>


            <!-- Time Pill -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/mcvLogPrimaryValueBG"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/entity_rent_bg"
                app:strokeWidth="0dp">

                <TextView
                    android:id="@+id/tvLogPrimaryValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/text_value_amount"
                    android:textSize="13sp"
                    android:textColor="@color/entity_rent_icon"
                    android:textStyle="bold"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"/>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Description Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/mcvEntityDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="0.6dp"
            app:strokeColor="@color/entity_rent_bg_border"
            app:cardBackgroundColor="@color/entity_rent_bg">

            <TextView
                android:id="@+id/tvActivityLogDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp"
                android:text="@string/text_activity_log_desc"
                android:textSize="14sp"
                android:textColor="@color/text_muted"
                android:lineSpacingExtra="2dp"/>

        </com.google.android.material.card.MaterialCardView>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.7dp"
            android:background="@color/light_separator"
            android:layout_marginTop="14dp"/>

    </LinearLayout>

</LinearLayout>
