<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:layout_marginHorizontal="20dp"
    android:background="@drawable/background_list_layout">

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/text_dialog_uploading_file"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/text_heading"
        android:layout_marginBottom="6dp" />

    <!-- Subheading -->
    <TextView
        android:id="@+id/tvUploadDialogSubHeading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/text_sub_being_uploading"
        android:textSize="16sp"
        android:textColor="@color/text_muted"
        android:layout_marginBottom="16dp" />

    <!-- Progress bar -->
    <ProgressBar
        android:id="@+id/profileUploadBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:progress="0"
        android:max="100"
        android:progressTint="@color/primary_main"
        android:backgroundTint="@color/text_muted"
        android:layout_marginBottom="10dp"
        android:indeterminate="false" />

    <!-- Upload info row -->
    <TextView
        android:id="@+id/tvUploadPercentage"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:text="@string/text_some_percentage"
        android:layout_weight="1"
        android:textSize="15sp"
        android:textColor="@color/text_muted" />

</LinearLayout>
