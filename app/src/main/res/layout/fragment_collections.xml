<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_app_surface">

    <HorizontalScrollView
        android:id="@+id/hsvPropertiesChips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_gravity="center_vertical">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupProperties"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp"
            android:paddingTop="16sp"
            android:paddingBottom="12dp"
            android:orientation="horizontal"
            app:singleSelection="true"
            app:selectionRequired="true"
            app:chipSpacingHorizontal="8dp"/>
    </HorizontalScrollView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="20dp"
        app:cardElevation="2dp"
        android:layout_marginHorizontal="14dp"
        android:layout_marginBottom="8dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/border_dashboard_card"
        app:cardBackgroundColor="@color/bg_dashboard_card">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp">

            <!-- Wallet Icon (Top Right) -->
            <ImageView
                android:id="@+id/imgWallet"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentTop="true"
                android:contentDescription="@string/text_image_desc"
                android:src="@drawable/ic_wallet_rupee"
                app:tint="@color/icon_wallet_color"
                android:layout_marginEnd="4dp"/>

            <!-- Content Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Title -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/text_total_collected"
                    android:textSize="12sp"
                    android:textAllCaps="true"
                    android:layout_marginStart="6dp"
                    android:textColor="@color/text_heading" />

                <!-- Amount -->
                <TextView
                    android:id="@+id/tvTotalPropAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/text_value_amount"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_main"
                    android:layout_marginStart="6dp" />

                <!-- Inner Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/border_info_container"
                    app:cardBackgroundColor="@color/bg_list_layout_primary">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="10dp">

                        <!-- Rent -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <!-- Icon BG -->
                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="38dp"
                                android:layout_height="38dp"
                                app:cardBackgroundColor="@color/bg_dashboard_card"
                                app:cardCornerRadius="12dp"
                                app:strokeWidth="0dp"
                                app:cardElevation="0dp">

                                <ImageView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:contentDescription="@string/text_image_desc"
                                    android:padding="5dp"
                                    android:src="@drawable/ic_home_rent"
                                    app:tint="@color/icon_primary" />
                            </com.google.android.material.card.MaterialCardView>

                            <!-- Text -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_marginStart="8dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/text_label_rent"
                                    android:textSize="13sp"
                                    android:textColor="@color/text_subheading_fade"/>

                                <TextView
                                    android:id="@+id/tvTotalPropRent"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/text_value_amount"
                                    android:textSize="16sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/primary_main"/>
                            </LinearLayout>

                        </LinearLayout>

                        <!-- Divider -->
                        <View
                            android:layout_width="0.7dp"
                            android:layout_height="32dp"
                            android:layout_marginHorizontal="16dp"
                            android:background="@color/light_separator"/>

                        <!-- Electricity -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <!-- Icon BG -->
                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="38dp"
                                android:layout_height="38dp"
                                app:cardBackgroundColor="@color/bg_dashboard_card"
                                app:cardCornerRadius="12dp"
                                app:strokeWidth="0dp"
                                app:cardElevation="0dp">

                                <ImageView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:contentDescription="@string/text_image_desc"
                                    android:padding="10dp"
                                    android:src="@drawable/ic_electric_bolt"
                                    app:tint="@color/bg_orange" />
                            </com.google.android.material.card.MaterialCardView>

                            <!-- Text -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_marginStart="8dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/text_label_elc_bill"
                                    android:textSize="12sp"
                                    android:textColor="@color/text_subheading_fade"/>

                                <TextView
                                    android:id="@+id/tvTotalPropElcBill"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/text_value_amount"
                                    android:textSize="16sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/bg_orange"/>
                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </RelativeLayout>

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/btnTemp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/text_label_monthly_collections"
        android:textSize="20sp"
        android:layout_marginHorizontal="16sp"
        android:layout_marginVertical="8dp"
        android:textStyle="bold"
        android:textColor="@color/text_heading"/>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">




        <!-- RecyclerView below the header -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/collectionListRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="8dp"
            android:paddingVertical="6dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp" />

        <ProgressBar
            android:id="@+id/progressBarCollections"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="60dp"
            android:indeterminateTint="@color/primary_main"/>


        <LinearLayout
            android:id="@+id/layoutNoCollection"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone"
            android:gravity="center_horizontal"
            android:paddingTop="50dp">

            <!-- Icon -->
            <ImageView
                android:id="@+id/img_empty_property"
                android:layout_width="180dp"
                android:layout_height="120dp"
                android:scaleType="centerCrop"
                android:src="@drawable/img_no_monthly_coll_record"
                android:layout_marginBottom="24dp"
                android:contentDescription="@string/text_image_desc"/>

            <!-- Title -->
            <TextView
                android:id="@+id/tv_empty_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/text_heading_no_monthly_collection"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text_heading"
                android:gravity="center" />

            <!-- Subtitle -->
            <TextView
                android:id="@+id/tv_empty_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/text_sub_no_monthly_collection"
                android:textSize="14sp"
                android:layout_marginHorizontal="28dp"
                android:textColor="@color/text_muted"
                android:gravity="center"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="4dp" />

        </LinearLayout>
    </FrameLayout>

</LinearLayout>
