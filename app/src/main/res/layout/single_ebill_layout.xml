<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="20dp"
        app:cardElevation="1dp"
        android:layout_marginVertical="6dp"
        android:layout_marginHorizontal="2dp"
        app:strokeWidth="1dp"
        app:strokeColor="#E6EAF0"
        android:backgroundTint="@android:color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16sp"
            android:paddingTop="16sp"
            android:paddingBottom="12dp">

            <!-- Top Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Icon -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    android:backgroundTint="#E9F8F4">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/text_image_desc"
                        android:padding="10dp"
                        android:src="@drawable/ic_receipt_long"
                        app:tint="@color/icon_primary" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Month & Units -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:id="@+id/tvElcBillMonthYear"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/text_value_month_year"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#1F2937" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/text_symbol_plus"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#009688" />

                        <TextView
                            android:id="@+id/tvBillUsedUnit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/text_any_number"
                            android:textSize="14sp"
                            android:layout_marginHorizontal="3dp"
                            android:textStyle="bold"
                            android:textColor="#009688" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/text_units"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#009688" />

                    </LinearLayout>
                </LinearLayout>

                <!-- Amount & Mode -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="end">

                    <TextView
                        android:id="@+id/tvBillAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/text_value_amount"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#009688" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="4dp"
                        tools:ignore="UseCompoundDrawables">

                        <ImageView
                            android:id="@+id/imgBillPaymentMode"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:contentDescription="@string/text_image_desc"
                            android:src="@drawable/ic_cash_payment"
                            app:tint="#9AA3AF" />

                        <TextView
                            android:id="@+id/tvBillPaymentMode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/text_cash"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#9AA3AF"
                            android:layout_marginStart="6dp" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="10dp"
                android:background="@color/light_separator" />

            <!-- Bottom Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Date -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    tools:ignore="UseCompoundDrawables">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:contentDescription="@string/text_image_desc"
                        android:src="@drawable/ic_clock"
                        app:tint="#9AA3AF" />

                    <TextView
                        android:id="@+id/tvBillDateTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/text_value_date_time"
                        android:textSize="13sp"
                        android:textStyle="italic"
                        android:textColor="#6B7280"
                        android:layout_marginStart="8dp" />
                </LinearLayout>

                <!-- Paid Till Chip -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    android:backgroundTint="#FFF4D6">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:contentDescription="@string/text_image_desc"
                            android:src="@drawable/ic_electric_bolt"
                            app:tint="#F59E0B" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/text_paid_till_colon"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#F59E0B"
                            android:layout_marginStart="6dp"
                            android:layout_marginEnd="3dp"/>

                        <TextView
                            android:id="@+id/tvBillPaidTill"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/text_any_number"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#F59E0B"/>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>



</LinearLayout>
