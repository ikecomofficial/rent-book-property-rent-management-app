<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_app_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16sp"
        android:visibility="gone">

        <!-- Property Name -->
        <TextView
            android:id="@+id/tvPropertyName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/text_property_name"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/text_heading"/>

        <!-- Address Row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            tools:ignore="UseCompoundDrawables">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@string/text_image_desc"
                android:src="@drawable/ic_home_location"
                app:tint="@color/icon_primary"/>

            <TextView
                android:id="@+id/tvPropertyAddress"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:text="@string/text_value_city"
                android:textColor="@color/text_muted"
                android:textSize="14sp" />
        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingVertical="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/text_label_overview"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_weight="1"
            android:textColor="@color/text_heading" />

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@string/text_image_desc"
            android:src="@drawable/ic_calendar_month"
            app:tint="@color/icon_primary"
            android:layout_gravity="center"/>

        <TextView
            android:id="@+id/currMonthYear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/text_value_month_year"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginStart="4dp"
            android:textColor="@color/primary_main" />



    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardDashboardSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="6dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@color/bg_dashboard_card"
        app:strokeWidth="1dp"
        app:strokeColor="@color/border_dashboard_card">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:padding="16dp">

            <!-- Circular progress -->
            <FrameLayout
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:layout_gravity="center">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/occupancyProgressBar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:progress="30"
                    android:max="100"
                    android:layout_gravity="center"
                    app:indicatorColor="@color/progress_active"
                    app:indicatorSize="100dp"
                    app:trackColor="@color/progress_inactive"
                    app:trackThickness="8dp"
                    app:trackCornerRadius="5dp" />
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_gravity="center">
                    <TextView
                        android:id="@+id/tvProgressLabel"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="@string/text_any_number"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_heading"
                        android:gravity="center"/>

                    <TextView
                        android:id="@+id/tvProgressLabel3"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="@string/text_occupied"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_muted"
                        android:gravity="center"/>


                </LinearLayout>

            </FrameLayout>

            <!-- RIGHT : Content -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_weight="1">

                        <!-- Rent Collected -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:ignore="UseCompoundDrawables">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:contentDescription="@string/text_image_desc"
                                android:src="@drawable/ic_cash_payment"
                                app:tint="@color/icon_primary" />

                            <TextView
                                android:id="@+id/tvRentCollectedLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/text_label_rent_coll_cap"
                                android:textSize="12sp"
                                android:layout_marginStart="6dp"
                                android:textColor="@color/text_subheading" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvMonthTotalRent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/text_value_amount"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_heading" />

                    </LinearLayout>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/mcvMonthlyCollectionActivity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:elevation="1dp"
                        app:cardCornerRadius="16dp"
                        app:strokeWidth="1dp"
                        android:visibility="gone"
                        app:strokeColor="@color/border_list_layout_primary"
                        app:cardBackgroundColor="@color/bg_list_layout_primary">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="12dp"
                            android:paddingEnd="7dp"
                            android:paddingVertical="4dp"
                            tools:ignore="UseCompoundDrawables">

                            <TextView
                                android:id="@+id/tvCurrentMY"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/text_value_month_year"
                                android:textColor="@color/text_muted"/>

                            <ImageView
                                android:layout_width="16sp"
                                android:layout_height="16sp"
                                android:contentDescription="@string/text_image_desc"
                                android:rotation="90"
                                android:layout_marginStart="3dp"
                                android:layout_gravity="center_vertical"
                                android:src="@drawable/ic_exp_arrow_right"
                                app:tint="@color/icon_primary"/>
                        </LinearLayout>



                    </com.google.android.material.card.MaterialCardView>


                </LinearLayout>



                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="8dp"
                    android:background="@color/light_separator"/>

                <!-- Bottom Stats -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <!-- Utilities -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:ignore="UseCompoundDrawables">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:contentDescription="@string/text_image_desc"
                                android:src="@drawable/ic_electric_bolt"
                                app:tint="@color/bg_orange" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="5dp"
                                android:text="@string/text_label_elc_bill_cap"
                                android:layout_gravity="center_vertical"
                                android:textColor="@color/text_subheading"
                                android:textSize="12sp" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvMonthTotalElcBill"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/text_value_amount"
                            android:layout_marginStart="2dp"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_heading" />
                    </LinearLayout>

                    <!-- Active Units -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:ignore="UseCompoundDrawables">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:contentDescription="@string/text_image_desc"
                                android:src="@drawable/ic_meter_reading"
                                app:tint="@color/icon_primary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="5dp"
                                android:text="@string/text_label_consumed_cap"
                                android:layout_gravity="center_vertical"
                                android:textColor="@color/text_subheading"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:ignore="UseCompoundDrawables"
                            android:layout_marginStart="2dp">

                            <TextView
                                android:id="@+id/tvMonthTotalUnitsUsed"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/text_any_number"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_heading" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/text_units"
                                android:layout_marginStart="4dp"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_muted" />

                        </LinearLayout>


                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>


    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/text_label_rooms_shops"
        android:textSize="20sp"
        android:layout_marginHorizontal="16sp"
        android:layout_marginTop="12dp"
        android:textStyle="bold"
        android:textColor="@color/text_heading"/>

    <!-- RecyclerView below the header -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/roomsListRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="8dp"
        android:paddingVertical="6dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp" />


</LinearLayout>
