<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app_surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginVertical="18dp">

            <!-- TITLE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/text_label_prop_details_cap"
                android:textAllCaps="true"
                android:textColor="@color/text_muted"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginHorizontal="14dp"
                android:background="@color/text_subheading_fade"/>

        </LinearLayout>

        <!-- CARD -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="24dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="@color/bg_list_layout_primary"
            app:strokeColor="@color/border_dashboard_card"
            app:strokeWidth="0.5dp"
            android:layout_marginHorizontal="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- PROPERTY NAME LABEL -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/text_property_name"
                    android:textColor="@color/text_subheading"
                    android:textSize="13sp"
                    android:textAllCaps="true"
                    android:textStyle="bold"
                    android:letterSpacing="0.04"
                    android:paddingBottom="8dp"/>

                <!-- PROPERTY NAME INPUT -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_et_input"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@string/text_image_desc"
                        android:src="@drawable/ic_properties"
                        app:tint="@color/icon_primary"/>

                    <EditText
                        android:id="@+id/editTextPropertyName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="none"
                        android:hint="@string/text_hint_property_name"
                        android:textColorHint="@color/text_subheading_fade"
                        android:textColor="@color/text_heading"
                        android:background="@android:color/transparent"
                        android:paddingStart="12dp"
                        android:paddingEnd="2dp"
                        android:maxLength="30"
                        android:paddingVertical="14dp"
                        android:inputType="textCapWords"
                        android:textSize="16sp"/>
                </LinearLayout>

                <!-- SPACE -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="20dp"/>

                <!-- ADDRESS LABEL -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/text_label_address"
                    android:textColor="@color/text_subheading"
                    android:textSize="13sp"
                    android:textAllCaps="true"
                    android:textStyle="bold"
                    android:letterSpacing="0.04"
                    android:paddingBottom="8dp"/>

                <!-- ADDRESS INPUT -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_et_input"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@string/text_image_desc"
                        android:src="@drawable/ic_home_location"
                        app:tint="@color/icon_primary"/>

                    <EditText
                        android:id="@+id/editTextPropertyAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="none"
                        android:hint="@string/text_hint_address"
                        android:textColorHint="@color/text_subheading_fade"
                        android:textColor="@color/text_heading"
                        android:background="@android:color/transparent"
                        android:paddingStart="12dp"
                        android:paddingEnd="2dp"
                        android:maxLength="30"
                        android:paddingVertical="14dp"
                        android:inputType="textCapWords"
                        android:textSize="16sp"/>
                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- TITLE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginVertical="18dp">

            <!-- TITLE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/text_label_configuration_cap"
                android:textAllCaps="true"
                android:textColor="@color/text_muted"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginHorizontal="14dp"
                android:background="@color/text_subheading_fade"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <!-- CARD 1: TOTAL ROOMS -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:cardCornerRadius="24dp"
                app:strokeWidth="0.5dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border_dashboard_card"
                app:cardBackgroundColor="@color/bg_list_layout_primary">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp">

                    <!-- Title -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/text_label_total_rooms"
                        android:textAllCaps="true"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_subheading"
                        android:letterSpacing="0.1" />

                    <!-- Controls -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp">

                        <!-- Minus -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/mcvBtnRoomsMinus"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            app:cardCornerRadius="18dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp"
                            app:cardBackgroundColor="@color/edit_text_bg"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_gravity="center"
                                android:contentDescription="@string/text_image_desc"
                                android:src="@drawable/ic_input_minus"
                                app:tint="@color/icon_primary"/>

                        </com.google.android.material.card.MaterialCardView>

                        <!-- Value -->
                        <TextView
                            android:id="@+id/textTotalRooms"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:layout_weight="1"
                            android:text="@string/text_any_number"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_heading" />

                        <!-- Plus -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/mcvBtnRoomsPlus"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            app:cardCornerRadius="18dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp"
                            app:cardBackgroundColor="@color/edit_text_bg"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_gravity="center"
                                android:contentDescription="@string/text_image_desc"
                                android:src="@drawable/ic_input_plus"
                                app:tint="@color/icon_primary"/>

                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <View
                android:layout_width="12dp"
                android:layout_height="match_parent"/>


            <!-- CARD 2: TOTAL SHOPS -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:cardCornerRadius="20dp"
                app:strokeWidth="0.5dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border_dashboard_card"
                app:cardBackgroundColor="@color/bg_list_layout_primary">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp">

                    <!-- Title -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/text_label_total_shops"
                        android:textAllCaps="true"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_subheading"
                        android:letterSpacing="0.1" />

                    <!-- Controls -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp">

                        <!-- Minus -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/mcvBtnShopsMinus"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            app:cardCornerRadius="18dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp"
                            app:cardBackgroundColor="@color/edit_text_bg"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_gravity="center"
                                android:contentDescription="@string/text_image_desc"
                                android:src="@drawable/ic_input_minus"
                                app:tint="@color/icon_primary"/>

                        </com.google.android.material.card.MaterialCardView>

                        <!-- Value -->
                        <TextView
                            android:id="@+id/textTotalShops"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:layout_weight="1"
                            android:text="@string/text_any_number"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_heading" />

                        <!-- Plus -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/mcvBtnShopsPlus"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            app:cardCornerRadius="18dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp"
                            app:cardBackgroundColor="@color/edit_text_bg"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_gravity="center"
                                android:contentDescription="@string/text_image_desc"
                                android:src="@drawable/ic_input_plus"
                                app:tint="@color/icon_primary"/>

                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginVertical="18dp">

            <!-- TITLE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/text_label_financial_cap"
                android:textAllCaps="true"
                android:textColor="@color/text_muted"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginHorizontal="14dp"
                android:background="@color/text_subheading_fade"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <!-- CARD 1: TOTAL ROOMS -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:cardCornerRadius="24dp"
                app:strokeWidth="0.5dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border_dashboard_card"
                app:cardBackgroundColor="@color/bg_list_layout_primary">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp">

                    <!-- Title -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/text_label_base_rent"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_subheading"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="12dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_et_input"
                        android:paddingHorizontal="16dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:contentDescription="@string/text_image_desc"
                            android:src="@drawable/ic_cash_payment"
                            app:tint="@color/icon_primary"/>

                        <EditText
                            android:id="@+id/editTextDefaultRent"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:autofillHints="none"
                            android:background="@android:color/transparent"
                            android:hint="@string/text_value_amount"
                            android:maxLength="7"
                            android:textSize="16sp"
                            android:paddingVertical="14dp"
                            android:textColor="@color/text_heading"
                            android:textColorHint="@color/text_subheading_fade"
                            android:inputType="number"
                            android:paddingHorizontal="12dp"/>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <View
                android:layout_width="12dp"
                android:layout_height="match_parent"/>


            <!-- CARD 2: TOTAL SHOPS -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:cardCornerRadius="20dp"
                app:strokeWidth="0.5dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border_dashboard_card"
                app:cardBackgroundColor="@color/bg_list_layout_primary">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp">

                    <!-- Title -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/text_label_elc_unit_rate"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_subheading"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="12dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_et_input"
                        android:paddingHorizontal="16dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@string/text_image_desc"
                            android:src="@drawable/ic_electric_bolt"
                            app:tint="@color/bg_orange"/>

                        <EditText
                            android:id="@+id/editTextUnitRate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@android:color/transparent"
                            android:hint="@string/text_value_amount"
                            android:textSize="16sp"
                            android:maxLength="7"
                            android:autofillHints="none"
                            android:paddingVertical="14dp"
                            android:textColor="@color/text_heading"
                            android:textColorHint="@color/text_subheading_fade"
                            android:inputType="numberDecimal"
                            android:paddingHorizontal="12dp"/>

                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="32dp"/>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnCreateProperty"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:clickable="true"
            android:focusable="true"
            app:cardCornerRadius="50dp"
            android:layout_margin="3dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/btn_primary">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center"
                tools:ignore="UseCompoundDrawables">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/text_image_desc"
                    android:src="@drawable/ic_add_property"
                    app:tint="#FFFFFF"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/text_btn_create_property"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"/>
            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <Space
            android:layout_width="match_parent"
            android:layout_height="16dp"/>

    </LinearLayout>

</ScrollView>